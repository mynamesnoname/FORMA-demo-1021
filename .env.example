###############################################################################
#  Redrock Configuration / Redrock 配置
###############################################################################

# Redrock template directory / 模板目录
RR_TEMPLATE_DIR=
# Archetype directory (optional, used when USE_ARCHETYPES=true) / Archetype 目录（可选）
ARCHETYPE_DIR=
# Use archetypes in Redrock fitting / 拟合时使用 archetypes
# Default: true
USE_ARCHETYPES=true
# Maximum number of redshift minima per subtype / 每种 subtype 的红移极小值数量
# Code default: 9; this demo example selects 2.
NMINIMA=2
# Number of nearest archetypes / 最近 archetype 数量
# Default: 2
NNEAREST=2
# OpenMP threads for Redrock / Redrock 的 OpenMP 线程数
# Default: 1
OMP_NUM_THREADS=1
# Archetype continuum polynomial degree; 0 disables Legendre terms / archetype 的 Legendre 阶数，0 表示不使用
RR_ARCHETYPE_LEGENDRE_DEGREE=2
# Prior sigma on Legendre coefficients; 0 disables this prior / Legendre 系数先验的 sigma，0 表示关闭
RR_ARCHETYPE_LEGENDRE_PRIOR_SIGMA=0.1

###############################################################################
#  LLM Configuration / 大语言模型配置
###############################################################################

# API key for the text LLM / 文本 LLM 的 API 密钥
LLM_API_KEY=
# Base URL for the LLM API (OpenAI-compatible) / LLM API 地址（OpenAI 兼容）
LLM_BASE_URL=
# Model name, e.g. deepseek-v4-pro / 模型名称
LLM_MODEL=

# Max tokens per response; empty uses the graph client's provider fallback.
# 单次响应最大 token 数；留空时使用图客户端的服务商回退值。
LLM_MAX_TOKENS=

###############################################################################
#  Graph Investigation / 图调查
###############################################################################

# Optional seed for the recorded random permutation that assigns neutral
# H1...Hn labels to Redrock hypotheses. Empty = generate and record a fresh
# seed every run. Setting the same value replays the same label map for the
# same fit-content set. The mapping is written to hypothesis_labels.json.
# 可选种子：用于给 Redrock 假设分配中性 H1...Hn 标签的记录化随机排列。
# 留空 = 每次运行生成并记录新种子。设置相同值可在相同拟合内容集合上重放相同标签映射。
# 映射写入 hypothesis_labels.json。
HYPOTHESIS_LABEL_SEED=

# Optional path to instrument, CWT, Gaussian fitting, continuum, audit and
# evaluation method JSON; default is config/analysis_method.json.
# 可选方法 JSON 路径；默认读取 config/analysis_method.json。
# FORMA_ANALYSIS_METHOD_CONFIG=config/analysis_method.json

# Optional stage-specific sampling policy; default is config/model_calls.json.
# 可选分阶段模型采样配置；默认读取 config/model_calls.json。
# FORMA_MODEL_CALL_CONFIG=config/model_calls.json

# Optional path to rule-operand threshold overrides (empirical bounds, e.g. the
# 1500 km/s Type-1 broad-line limit). Omit to use config/rule_parameters.json if
# present, else the ontology registry defaults. Keys are "<rule_id>.<operand_id>";
# only operands that declare a threshold are accepted, and the run records the
# applied value, unit, source and payload digest in every rule trace.
# 可选：经验参数覆盖。不设置时依次使用 config/rule_parameters.json 或本体注册表默认值。
# v2 载荷两段：overrides 以 "<rule_id>" -> {"<operand_id>": value} 覆盖规则操作数界；
# parameters 以 "<membership|parameter id>" -> {"<name>": value} 覆盖注册表声明的经验参数
# （模糊隶属函数、标量容差）。只接受注册表已声明的旋钮，非法形状/未声明项会被拒绝；运行会把
# 生效值/单位/来源/载荷摘要写进规则 trace 与参数摘要。
# FORMA_RULE_PARAMETERS=config/rule_parameters.json
