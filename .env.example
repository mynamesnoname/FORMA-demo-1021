###############################################################################
#  Overall Configuration / 全局配置
###############################################################################

# Retry attempts on connection error / 连接错误重试次数
# Default: 3
MAX_TRIES=3
# Retry delay in seconds / 重试间隔（秒）
# Default: 180
RETRY_DELAY=180

# ── Redrock redshift fitter (required) / Redrock 红移拟合器（必需）──
# Redrock template directory / 模板目录
RR_TEMPLATE_DIR=
# Archetype directory (optional, used when USE_ARCHETYPES=true) / Archetype 目录（可选）
ARCHETYPE_DIR=
# Use archetypes in Redrock fitting / 拟合时使用 archetypes
# Default: true
USE_ARCHETYPES=true
# Maximum number of redshift minima per subtype / 每种 subtype 的红移极小值数量
# Default: 9 (at most 9*5[subtypes]=45 hypotheses in all)
NMINIMA=9
# Number of nearest archetypes / 最近 archetype 数量
# Default: 2
NNEAREST=2
# OpenMP threads for Redrock / Redrock 的 OpenMP 线程数
# Default: 1
OMP_NUM_THREADS=1
# Archetype continuum polynomial degree; 0 disables Legendre terms / archetype 的 Legendre 阶数，0 表示不使用
RR_ARCHETYPE_LEGENDRE_DEGREE=2
# Prior sigma on Legendre coefficients; 0 disables this prior / Legendre 系数先验的 sigma，0 表示关闭
RR_ARCHETYPE_LEGENDRE_PRIOR_SIGMA=0.1

###############################################################################
#  LLM Configuration / 大语言模型配置
###############################################################################

# API key for the text LLM / 文本 LLM 的 API 密钥
LLM_API_KEY=
# Base URL for the LLM API (OpenAI-compatible) / LLM API 地址（OpenAI 兼容）
LLM_BASE_URL=
# Model name, e.g. deepseek-v4-pro / 模型名称
LLM_MODEL=

# Generic model sampling temperature; stage-specific calls use config/model_calls.json.
# 通用模型采样温度；各阶段调用由 config/model_calls.json 控制。
LLM_TEMPERATURE=
# Max tokens per response (empty = API default) / 每次响应的最大 token 数（留空 = API 默认）
LLM_MAX_TOKENS=

# Thinking mode / 思考模式
# - disabled: turn off thinking to avoid reasoning_content passback in multi-turn tool calls
#             关闭思考模式，回避多轮工具调用中 reasoning_content 回传问题
# - enabled:  turn on thinking / 开启思考模式
# - none:     recommended for Qwen series / 推荐用于 Qwen 系列
# Default: disabled
LLM_THINKING=disabled

################################################################################
#  I/O Configuration / 输入输出配置
################################################################################

# Run mode: s = single file, b = batch / s = 单文件, b = 批处理
RUN_MODE=s

# Input directory containing .fits files / 存放 .fits 文件的输入目录
INPUT_DIR=
# Input file format / 输入文件格式
INPUT_FORMAT=fits
# Output directory for results / 结果输出目录
OUTPUT_DIR=

# ── Single mode / 单文件模式 ──
# FITS file name without extension (e.g. QSO_116 for QSO_116.fits) / 不含扩展名的文件名
FILE_NAME=

# ── Batch mode / 批处理模式 ──
# Base name prefix for a series of FITS files / 批量文件名前缀
FILE_BATCH_HEADER=
# Starting index / 起始索引
FILE_BATCH_START=
# Ending index / 结束索引
FILE_BATCH_END=

################################################################################
#  Pipeline Parameters / 管道参数
################################################################################

# ── Harness / 并行假设分析 ──
# Number of hypotheses analysed in parallel during the LLM targeted-search stage.
# Each harness invocation is an independent LangGraph agent call.
# Lower = less API load, higher = faster throughput.
# LLM 定向搜索阶段并行分析的假设数。每个 harness 调用是独立的 LangGraph 代理。
# 越小 = API 负载越低，越大 = 吞吐越快。
# Code default: 3; this example selects 50 / 代码默认值为 3；本示例选择 50
HARNESS_CONCURRENCY=50
# Optional seed for the recorded random permutation that assigns neutral
# H1...Hn labels to Redrock hypotheses. Empty = generate and record a fresh
# seed every run. Setting the same value replays the same label map for the
# same fit-content set. The mapping is written to hypothesis_label_map.json.
# 可选种子：用于给 Redrock 假设分配中性 H1...Hn 标签的记录化随机排列。
# 留空 = 每次运行生成并记录新种子。设置相同值可在相同拟合内容集合上重放相同标签映射。
# 映射写入 hypothesis_label_map.json。
HYPOTHESIS_LABEL_SEED=
# Build the deterministic Evidence Graph during VisualInterpreter.
# 在 VisualInterpreter 阶段构建确定性 Evidence Graph；本示例关闭。
EVIDENCE_GRAPH=false
# Emit structured run/stage telemetry JSON. Default true for WP-013.
# 输出结构化运行/阶段遥测 JSON。WP-013 默认开启。
TELEMETRY_ENABLED=true

# ── Self-evolution / 自进化（需要 ground truth）─
# Enable the self-evolution pathway. When enabled, the pipeline compares synthesis
# results against ground truth and records failures for batch root-cause analysis.
# 启用自进化路径。开启后，管道将综合结果与 ground truth 对比，记录失败样本用于批量根因分析。
# Default: false
SELF_EVOLVE=false
# Number of failed samples to accumulate before running batch analysis / 累积多少失败样本后触发批量分析
# Default: 5
FAILURE_BATCH_SIZE=5
# Ground-truth redshift / 真实红移值
EXPECTED_Z=
# Ground-truth classification: QSO, Galaxy (ELG), Galaxy (LRG/BGS), Star / 真实分类
EXPECTED_TYPE=
# Optional path to instrument, CWT, Gaussian fitting, continuum, audit and
# evaluation method JSON; default is config/analysis_method.json.
# 可选方法 JSON 路径；默认读取 config/analysis_method.json。
# FORMA_ANALYSIS_METHOD_CONFIG=config/analysis_method.json

# Optional stage-specific sampling policy; default is config/model_calls.json.
# 可选分阶段模型采样配置；默认读取 config/model_calls.json。
# FORMA_MODEL_CALL_CONFIG=config/model_calls.json

# Optional path to rule-operand threshold overrides (empirical bounds, e.g. the
# 1500 km/s Type-1 broad-line limit). Omit to use config/rule_parameters.json if
# present, else the ontology registry defaults. Keys are "<rule_id>.<operand_id>";
# only operands that declare a threshold are accepted, and the run records the
# applied value, unit, source and payload digest in every rule trace.
# 可选：经验参数覆盖。不设置时依次使用 config/rule_parameters.json 或本体注册表默认值。
# v2 载荷两段：overrides 以 "<rule_id>" -> {"<operand_id>": value} 覆盖规则操作数界；
# parameters 以 "<membership|parameter id>" -> {"<name>": value} 覆盖注册表声明的经验参数
# （模糊隶属函数、标量容差）。只接受注册表已声明的旋钮，非法形状/未声明项会被拒绝；运行会把
# 生效值/单位/来源/载荷摘要写进规则 trace 与参数摘要。
# FORMA_RULE_PARAMETERS=config/rule_parameters.json
